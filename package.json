{
  "private": true,
  "scripts": {
    "dotenvx": "dotenvx",
    "env:encrypt": "dotenvx encrypt && dotenvx encrypt -f .env.production",
    "env:decrypt": "dotenvx decrypt && dotenvx decrypt -f .env.production",
    "dev": "dotenvx run -- next dev --turbopack",
    "build": "npm run env:decrypt && next build",
    "start": "next start"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.36.0",
    "next": "latest",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "20.10.8",
    "@types/react": "18.2.47",
    "@types/react-dom": "18.2.18",
    "typescript": "^5.3.3"
  }
}
